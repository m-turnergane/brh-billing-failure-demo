{
  "name": "brh-billing-failure-demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.9.0" },
  "exports": {
    ".": "./src/demo.tsx",
    "./data": "./src/data.ts",
    "./fixtures": "./src/fixtures.mjs",
    "./evidence": "./evidence/recordings.json",
    "./verify": "./src/verify.mjs",
    "./styles.css": "./src/styles.css"
  },
  "files": ["src", "evidence", "LICENSE", "README.md"],
  "scripts": {
    "dev": "next dev -p 43128",
    "build": "npm run verify:evidence && next build",
    "start": "next start -p 43128",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "test": "node --test tests/evidence.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "vendor:site": "node scripts/vendor-site.mjs"
  },
  "dependencies": { "next": "16.3.5", "react": "19.2.8", "react-dom": "19.2.8" },
  "peerDependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@types/node": "^20", "@types/react": "^19", "@types/react-dom": "^19",
    "typescript": "^5", "eslint": "^9", "eslint-config-next": "16.3.5", "playwright": "^1.58.0"
  }
}
